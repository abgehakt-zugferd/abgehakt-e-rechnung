#!/usr/bin/env bash
# TDD-Enforcement pre-push hook, Variante für dieses Repo (Tests laufen NUR im Container).
# Standard-Kit-Runner (python3 -m pytest auf dem Host) wäre hier ein False-RED:
# der Host hat keine App-Dependencies. Siehe CONTRIBUTING.md.
set -uo pipefail

# Git startet Hooks mit gesetzten Repo-Variablen. Im verlinkten Worktree ist
# GIT_DIR absolut und zeigt aufs Eltern-Repo. Geerbt zeigt dann das REPOSITORY
# (Objekte, Refs, Index) aufs Eltern-Repo, waehrend der ARBEITSBAUM der
# richtige bleibt: ohne GIT_WORK_TREE ist das cwd. Schreibbefehle landen
# deshalb im fremden Repo — so entstehen Fremd-Commits mit dem Inhalt des
# eigenen Arbeitsbaums. Lesebefehle scheitern nicht, sie luegen: aus der Wurzel
# stimmt `rev-parse --show-toplevel` versehentlich, aus einem Unterordner
# antwortet es mit dem Unterordner. Betroffen ist JEDER git-Aufruf unterhalb
# des Hooks — die Testskripte ebenso wie die Werkzeuge, die von sich aus git
# rufen (composer, npm). Herkunft und Messprotokoll: Repo
# claude-global-skills, Skill tdd.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY \
      GIT_COMMON_DIR GIT_NAMESPACE GIT_QUARANTINE_PATH

# Zwei Schritte, nicht einer: `cd "$(git rev-parse ...)"` sieht aus wie ein
# Waechter, ist aber keiner. Scheitert rev-parse, ist die Ersetzung leer, und
# `cd ""` liefert in bash Exit 0 — geprueft wird der Ausgang von cd, nicht der
# von rev-parse. Der Hook lief dann im Aufrufverzeichnis weiter und startete
# Datenwache und Wachen dort (gemessen 2026-09-22, test_pre_push_waechter.sh).
wurzel="$(git rev-parse --show-toplevel)" || exit 1
[ -n "$wurzel" ] || { echo "pre-push: Repo-Wurzel nicht bestimmbar." >&2; exit 1; }
cd "$wurzel" || exit 1

# stdin nur einmal lesen (#219): Datenwache und Stand-Pruefung brauchen dieselben
# Zeilen. Command-Substitution frisst Schluss-Newlines; Markierung verhindert das.
push_refs=$(cat; printf x) || exit 1
push_refs=${push_refs%x}

# Datenwache (#49): nur neu hinzukommende Zeilen der gepushten Commits.
if ! printf '%s' "$push_refs" | .githooks/datenwache.sh; then
  echo "  Push blockiert." >&2
  exit 1
fi

leer=0000000000000000000000000000000000000000
# Je gepushter Ref den Stand <local sha> pruefen (Suite, Wachen, Gedankenstriche).
# Loeschungen (local sha = 0…0) ueberspringen. Mehrere Refs: jeder fuer sich.
# Default-IFS: Felder an Whitespace trennen. `IFS= read` wuerde die ganze Zeile
# in das erste Feld legen und lokal_sha leer lassen (Push ohne Stand-Pruefung).
while read -r _lokal_ref lokal_sha _fern_ref _fern_sha || [ -n "${lokal_sha:-}" ]; do
  [ -z "${lokal_sha:-}" ] && continue
  [ "$lokal_sha" = "$leer" ] && continue
  if ! .githooks/pre-push-stand.sh "$lokal_sha"; then
    exit 1
  fi
done <<EOF
$push_refs
EOF

echo "tdd: grün, Push erlaubt."
exit 0
