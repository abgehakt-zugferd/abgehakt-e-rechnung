# Datenbank — drei Rollen (kein Superuser im Betrieb)
#
# 1. Bootstrap-Superuser: legt Postgres beim ERSTEN Volume-Init als POSTGRES_USER an.
#    Diese Rolle (OID 10) ist von Postgres aus NIE demotierbar
#    ("The bootstrap user must have the SUPERUSER attribute") — daher eine eigene
#    Rolle, die im Betrieb nicht benutzt wird (Break-Glass).
DB_BOOTSTRAP_USER=abgehakt_db
DB_BOOTSTRAP_PASSWORD=bootstrap_passwort_hier

# 2. Owner-/Migrations-Rolle: NOSUPERUSER, CREATEROLE, CREATEDB. Besitzt die Tabellen,
#    führt Alembic + pg_dump aus. Wird beim Start automatisch angelegt und auf dem
#    hier gesetzten Passwort gehalten (scripts/bootstrap_owner.py, läuft vor Alembic).
#    Kein Handgriff nötig — auch nicht bei einer Passwortänderung.
DB_USER=abgehakt_admin
DB_PASSWORD=owner_passwort_hier
DB_NAME=abgehakt

# 3. Least-Privilege-App-Rolle — Passwort NUR hier, nie im Code/Migration
DB_APP_USER=abgehakt_app
DB_APP_PASSWORD=app-passwort-hier
APP_DATABASE_URL=postgresql://abgehakt_app:app-passwort-hier@db:5432/abgehakt

# Kein SECRET_KEY: der Schlüssel verwaltet sich selbst in storage/secret.key.
# Wird er hier gesetzt und später geändert, ist das verschlüsselte SMTP-Passwort
# in der Datenbank nicht mehr lesbar.

# SMTP (für E-Mail-Versand an Kunden + DATEV BCC)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=benutzer@example.com
SMTP_PASSWORD=app-passwort-nicht-kontopasswort
SMTP_FROM=rechnungen@example.com
SMTP_USE_TLS=true

# DATEV Upload Mail – Kryptische Rechnungsausgang-Adresse
# Einrichten unter: duo.datev.de → Belege → Einstellungen → Upload Mail
DATEV_BCC_EMAIL=kryptischeID@uploadmail.datev.de
